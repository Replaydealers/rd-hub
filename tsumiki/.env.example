# Tsumiki V1.0 – Einstellungen. Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Ohne Einträge läuft alles im Demo-Modus (simulierte Zahlung, keine Push-Nachricht).

# Passwort für die Verwaltung (http://localhost:3000/admin/, Benutzername egal)
ADMIN_PASSWORD=bitte-aendern

# Adresse, unter der die Seite erreichbar ist (lokal so lassen; später z. B. https://tsumiki.de)
BASE_URL=http://localhost:3000
PORT=3000

# Push-Nachricht aufs Handy bei jeder neuen Bestellung:
# 1. App "ntfy" installieren (iOS/Android, kostenlos)
# 2. Ein schwer zu erratendes Thema abonnieren, z. B. tsumiki-bastian-8k2m
# 3. Genau dieses Thema hier eintragen
NTFY_TOPIC=

# PayPal (Sandbox zum Testen: developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# Stripe (Testschlüssel beginnen mit sk_test_ … → dashboard.stripe.com → Entwickler → API-Schlüssel)
# Karte, Apple Pay, Google Pay und Klarna schaltest du im Stripe-Dashboard unter "Zahlungsmethoden" frei.
STRIPE_SECRET_KEY=

# E-Mail-Versand über das IONOS-Postfach noreply@tsumiki.de.
# Nur das Passwort des Postfachs eintragen; ohne Passwort landen Mails nur im Postausgang der Verwaltung.
SMTP_PASS=
# Optional (Standardwerte): SMTP_HOST=smtp.ionos.de, SMTP_PORT=587, MAIL_FROM=Tsumiki <noreply@tsumiki.de>,
# MAIL_REPLY_TO=info@tsumiki.de, MAIL_BCC= (Kopie jeder Kundenmail, z. B. an info@tsumiki.de)

# Vor dem Start: SHOP_OFFEN=0 → Preisrechner läuft, statt Bestellen gibt es eine Warteliste
SHOP_OFFEN=1

# Optional anderer Speicherort der Excel-Datenbank
# EXCEL_FILE=C:\Tsumiki\Tsumiki_Datenbank.xlsx
